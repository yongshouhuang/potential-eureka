<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 发动机无关：netstandard2.1 兼容 Unity 6 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- 显式 using，避免隐式导入在 Unity 下引发冲突 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>XiaXia.Core</RootNamespace>
    <AssemblyName>XiaXia.Core</AssemblyName>
    <!-- 不产出 XML 文档警告，引擎迁移时按需补充 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- 仅编译 Core/ 下源码，绝不纳入 Core.Tests/ -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- JSON 解析；Unity 侧可替换为兼容实现（见 README） -->
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

</Project>
